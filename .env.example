# App
APP_ENV=development
# Local dev uses APP_PORT; Render injects PORT automatically
APP_PORT=8080
PORT=8080
APP_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL (Prisma) — local Docker; Render injects DATABASE_URL from managed Postgres
DATABASE_URL=postgresql://myndora:myndora_dev@localhost:5432/myndora_dev?schema=public

# Redis (USSD sessions TTL 120s, cache, alerts:new pub/sub)
REDIS_URL=redis://localhost:6379

# Firebase Auth
FIREBASE_PROJECT_ID=myndora-care-dev
FIREBASE_SERVICE_ACCOUNT_JSON=./backend/firebase-service-account.json

# GCP
GCP_PROJECT_ID=myndora-care-dev
GCP_REGION=africa-south1
GCS_PATIENT_FILES_BUCKET=myndora-patient-files-dev
GCS_PROVIDER_DOCS_BUCKET=myndora-provider-docs-dev
GCS_VITALS_EXPORTS_BUCKET=myndora-vitals-exports-dev
MOCK_GCS=true

# Africa's Talking
AT_USERNAME=sandbox
AT_API_KEY=your_at_api_key
AT_SENDER_ID=Myndora
AT_USSD_CODE=*384*MYNDORA#
MOCK_AT=true

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_key
PAYSTACK_PUBLIC_KEY=pk_test_your_key
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret
MOCK_PAYSTACK=true

# Commission rates
MYNDORA_CHW_COMMISSION=0.15
MYNDORA_CLINICIAN_COMMISSION=0.20
MYNDORA_PHARMACY_COMMISSION=0.05
MYNDORA_LAB_COMMISSION=0.08

# Feature flags
FEATURE_AI_SUMMARIES=false
FEATURE_PAYSTACK_LIVE=false
FEATURE_USSD=true
FEATURE_MARKETPLACE=true
FEATURE_PRESCRIPTION_WORKFLOW=true

# Escrow
ESCROW_AUTO_RELEASE_HOURS=48

# Web
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
