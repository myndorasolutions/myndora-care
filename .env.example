# App
# ENVIRONMENT: development | simulation | production (APP_ENV accepted as alias)
ENVIRONMENT=development
APP_ENV=development
# Local dev uses APP_PORT; Cloud Run injects PORT automatically
APP_PORT=8080
PORT=8080
APP_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL (Prisma) — local Docker; Cloud Run injects DATABASE_URL
# Supabase pooler (Transaction mode, port 6543) — used by Cloud Run runtime
DATABASE_URL=postgresql://myndora:myndora_dev@localhost:5432/myndora_dev?schema=public

# Direct connection (port 5432) — used by migrate/seed Cloud Run Job only
# Local Docker: same as DATABASE_URL
DIRECT_URL=postgresql://myndora:myndora_dev@localhost:5432/myndora_dev?schema=public

# Dual-deploy: simulation DB MUST differ from production (fail-closed in scripts)
# SIMULATION_DATABASE_URL=postgresql://postgres.<sim-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# SIMULATION_DIRECT_URL=postgresql://postgres.<sim-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# SIMULATION_SUPABASE_PROJECT_REF=
# PRODUCTION_DATABASE_URL=
# PRODUCTION_DIRECT_URL=
# PRODUCTION_SUPABASE_PROJECT_REF=

# Supabase project ref (for pooler username postgres.<ref>); used by deploy-cloud-run.ps1
SUPABASE_PROJECT_REF=

# Redis (USSD sessions TTL 120s, cache, alerts:new pub/sub)
REDIS_URL=redis://localhost:6379

# Firebase Auth
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON=./backend/firebase-service-account.json

# GCP
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west3
GCS_PATIENT_FILES_BUCKET=your-patient-files-bucket
GCS_PROVIDER_DOCS_BUCKET=your-provider-docs-bucket
GCS_VITALS_EXPORTS_BUCKET=your-vitals-exports-bucket
MOCK_GCS=true

# Africa's Talking
AT_USERNAME=sandbox
AT_API_KEY=your_at_api_key
AT_SENDER_ID=Myndora
AT_USSD_CODE=*384*MYNDORA#
MOCK_AT=true

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_key
PAYSTACK_PUBLIC_KEY=pk_test_your_key
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret
# Simulation forces MOCK_PAYSTACK=true. Production requires an explicit value.
MOCK_PAYSTACK=true

# Commission rates
MYNDORA_CHW_COMMISSION=0.15
MYNDORA_CLINICIAN_COMMISSION=0.20
MYNDORA_PHARMACY_COMMISSION=0.05
MYNDORA_LAB_COMMISSION=0.08

# Feature flags
FEATURE_AI_SUMMARIES=false
FEATURE_PAYSTACK_LIVE=false
FEATURE_USSD=true
FEATURE_MARKETPLACE=true
FEATURE_PRESCRIPTION_WORKFLOW=true

# Escrow
ESCROW_AUTO_RELEASE_HOURS=48

# Web
VITE_ENVIRONMENT=development
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
